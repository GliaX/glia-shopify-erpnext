# ---------------------------------------------------------------------------
# Example environment file. Copy to `.env` (dev) or supply via systemd-creds
# (production). See README.md "Secrets" section.
# ---------------------------------------------------------------------------

# --- Shopify (Dev Dashboard custom app) -----------------------------------
# Create the app at https://dev.shopify.com/dashboard (Dev Dashboard), install
# it on glia2, and grant scopes: read_products, read_orders, read_all_orders,
# read_customers. Find Client ID + Secret on the app's Settings -> Credentials.
# NOTE: there is no static access token anymore (deprecated Jan 1, 2026). The
# app mints a 24-hour access token from these credentials at runtime.
SHOPIFY_SHOP_DOMAIN=glia2.myshopify.com
SHOPIFY_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_CLIENT_SECRET=shpss_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2025-07

# --- ERPNext (Frappe REST API) --------------------------------------------
# Create a dedicated API user (e.g. shopify-sync@…) with roles Nonprofit
# Manager + System Manager, then generate API Key + Secret in the user's
# Api Access section.
ERPNEXT_BASE_URL=https://asset.glia.org
ERPNEXT_API_KEY=xxxxxxxxxxxxxxxxxx
ERPNEXT_API_SECRET=xxxxxxxxxxxxxxxxxx

# --- Patreon (API v2) -----------------------------------------------------
PATREON_CLIENT_ID=<from https://www.patreon.com/portal/registration/register-clients>
PATREON_CLIENT_SECRET=<from the same page>
PATREON_CREATOR_ACCESS_TOKEN=<from the same page>
PATREON_CREATOR_REFRESH_TOKEN=<from the same page>
PATREON_CAMPAIGN_ID=  # leave blank to auto-fetch

# --- Stripe (Phase 5 checkout) ---------------------------------------------
# From https://dashboard.stripe.com/apikeys. Leave blank to skip Stripe wiring
# (the rest of checkout is configured; re-run after adding them).
STRIPE_PUBLISHABLE_KEY=<pk_live_... from the Stripe API keys page>
STRIPE_SECRET_KEY=<sk_live_... from the Stripe API keys page>
STRIPE_WEBHOOK_SECRET=<whsec_... optional, for webhook verification>
